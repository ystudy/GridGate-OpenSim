<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for GridGate's region money module (money plan 2): its rules and actions, against a fake money service, and the
    module itself on a test region built with OpenSim's own test helpers (tests/OpenSim.Tests.Common).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runs on Microsoft.Testing.Platform (selected in global.json); no VSTest packages needed. -->
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../addon-modules/GridGateMoney/GridGateMoney.csproj">
      <Private>True</Private>
    </ProjectReference>
    <ProjectReference Include="../OpenSim.Tests.Common/OpenSim.Tests.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- An avatar in the test region loads OpenSim's default animations. -->
    <None Include="$(GgRoot)bin/data/avataranimations.xml" Link="data/avataranimations.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="OpenMetaverseTypes">
      <HintPath>$(GgRoot)bin/OpenMetaverseTypes.dll</HintPath>
    </Reference>
    <Reference Include="OpenMetaverse">
      <HintPath>$(GgRoot)bin/OpenMetaverse.dll</HintPath>
    </Reference>
    <Reference Include="log4net">
      <HintPath>$(GgRoot)bin/log4net.dll</HintPath>
    </Reference>
    <Reference Include="Nini">
      <HintPath>$(GgRoot)bin/Nini.dll</HintPath>
    </Reference>
    <Reference Include="OpenMetaverse.StructuredData">
      <HintPath>$(GgRoot)bin/OpenMetaverse.StructuredData.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
