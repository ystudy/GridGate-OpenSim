<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GridGate's Robust snapshot converter (spec 2026-11-21-featured-places-design, "Pictures"): POST /gridgate/j2k on
    Robust's private port turns a JPEG 2000 texture into a JPEG for the launcher's Featured page. Robust loads it from its
    [ServiceList]; it uses the CSJ2K and System.Drawing.Common Robust already ships.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>GridGateSnapshots</AssemblyName>
    <RootNamespace>GridGate.Robust.Snapshots</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <EnableDefaultItems>false</EnableDefaultItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <NoWarn>CA1416</NoWarn>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <UseCommonOutputDirectory>True</UseCommonOutputDirectory>
    <AppendTargetFrameworkToOutputPath>False</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>False</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>$(GgRoot)bin\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="log4net">
      <HintPath>$(GgRoot)bin\log4net.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="CSJ2K">
      <HintPath>$(GgRoot)bin\CSJ2K.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Drawing.Common">
      <HintPath>$(GgRoot)bin\System.Drawing.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Nini">
      <HintPath>$(GgRoot)bin\Nini.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenMetaverse">
      <HintPath>$(GgRoot)bin\OpenMetaverse.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenMetaverseTypes">
      <HintPath>$(GgRoot)bin\OpenMetaverseTypes.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(GgRoot)OpenSim\Framework\OpenSim.Framework.csproj">
      <Private>False</Private>
    </ProjectReference>
    <ProjectReference Include="$(GgRoot)OpenSim\Framework\Servers\HttpServer\OpenSim.Framework.Servers.HttpServer.csproj">
      <Private>False</Private>
    </ProjectReference>
    <ProjectReference Include="$(GgRoot)OpenSim\Server\Handlers\OpenSim.Server.Handlers.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="SnapshotConverter.cs" />
    <Compile Include="GridGateSnapshotsConnector.cs" />
  </ItemGroup>
</Project>
