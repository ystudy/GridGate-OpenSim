<Project Sdk="Microsoft.NET.Sdk">

  <!-- GridGate's region money module (money plan 2): forwards every money action to the launcher's money service. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>GridGateMoney</AssemblyName>
    <RootNamespace>GridGate.Region.Money</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <EnableDefaultItems>false</EnableDefaultItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <NoWarn>CA1416</NoWarn>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <UseCommonOutputDirectory>True</UseCommonOutputDirectory>
    <AppendTargetFrameworkToOutputPath>False</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>False</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>$(GgRoot)bin\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="log4net">
      <HintPath>$(GgRoot)bin\log4net.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Mono.Addins">
      <HintPath>$(GgRoot)bin\Mono.Addins.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Nini">
      <HintPath>$(GgRoot)bin\Nini.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenMetaverse">
      <HintPath>$(GgRoot)bin\OpenMetaverse.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenMetaverse.StructuredData">
      <HintPath>$(GgRoot)bin\OpenMetaverse.StructuredData.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenMetaverseTypes">
      <HintPath>$(GgRoot)bin\OpenMetaverseTypes.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(GgRoot)OpenSim\Framework\OpenSim.Framework.csproj">
      <Private>False</Private>
    </ProjectReference>
    <ProjectReference Include="$(GgRoot)OpenSim\Region\Framework\OpenSim.Region.Framework.csproj">
      <Private>False</Private>
    </ProjectReference>
    <ProjectReference Include="$(GgRoot)OpenSim\Services\Interfaces\OpenSim.Services.Interfaces.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="MoneyServiceClient.cs" />
    <Compile Include="MoneyModels.cs" />
    <Compile Include="MoneyActions.cs" />
    <Compile Include="UnpairedMoneyService.cs" />
    <Compile Include="VisitorHomes.cs" />
    <Compile Include="GridGateMoneyModule.cs" />
  </ItemGroup>
</Project>
