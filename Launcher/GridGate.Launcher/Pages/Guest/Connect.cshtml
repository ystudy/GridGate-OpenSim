@page "/guest/connect"
@model GridGate.Launcher.Pages.Guest.ConnectModel
@{
    ViewData["Title"] = T["Common.HowToConnect"].Value;
    ViewData["AvatarTab"] = "download";
}
@* The page head, then glowing cards (spec 2026-11-21-last-pages-restyle-design). *@
<section class="featured-head">
    <h1>@T["Connect.Heading", Model.GridName]</h1>
    <p class="featured-intro">@T["Connect.Choose", Model.GridName]</p>
</section>
@if (Model.Approved)
{
    <div class="alert alert-success connect-approved" role="status">@T["Connect.Approved", Model.DisplayName]</div>
}

<div class="connect-grid">
    <section id="viewer-firestorm" class="card connect-card connect-card-main">
        <div class="connect-card-head"><h2>Firestorm</h2><span class="connect-badge">@T["Connect.Recommended"]</span></div>
        <p class="connect-systems">@T["Connect.FirestormSystems"]</p>
        <a class="btn btn-primary btn-lg connect-download" href="@ConnectModel.Firestorm.Url" rel="noopener noreferrer">@T["Connect.Download"]</a>
        <p class="form-text mb-0">@T["Connect.FirestormNote"]</p>
    </section>
    <section id="viewer-others" class="card connect-card">
        <div class="connect-card-head"><h2>@T["Connect.OtherViewers"]</h2><span class="connect-card-note">@T["Connect.AnyViewer"]</span></div>
        <ul class="connect-list">
            @foreach (var v in ConnectModel.Others)
            {
                <li><span>@v.Name</span><a href="@v.Url" rel="noopener noreferrer">@T["Connect.Website"]</a></li>
            }
        </ul>
        <p class="form-text mb-0">@T["Connect.OthersNote"]</p>
    </section>
</div>

<section id="grid-settings-panel" class="card connect-card connect-wide">
    <div class="connect-card-head"><h2>@T["Connect.GridSettings"]</h2><button type="button" id="copy-settings" class="btn btn-sm btn-secondary" hidden data-copied="@T["Connect.Copied"]" data-selected="@T["Connect.CopySelected"]">@T["Connect.Copy"]</button></div>
    <pre id="grid-settings" class="connect-pre">@Model.SettingsText()</pre>
    <p class="form-text mb-0">@T["Connect.SettingsNote"]</p>
</section>

<div class="connect-grid">
    <section id="steps" class="card connect-card">
        <div class="connect-card-head"><h2>@T["Connect.Steps"]</h2></div>
        <ol class="connect-steps">
            <li>@T["Connect.Step1"]</li>
            <li>@T["Connect.Step2"] <code id="login-uri" class="connect-uri">@Model.LoginUri</code></li>
            <li>@T["Connect.Step3", Model.GridName]</li>
            @if (Model.DisplayName.Length > 0)
            {
                <li>@T["Connect.Step4Named", Model.DisplayName]</li>
            }
            else
            {
                <li>@T["Connect.Step4"]</li>
            }
        </ol>
    </section>
    <section id="help" class="card connect-card">
        <div class="connect-card-head"><h2 class="tone-text">@T["Connect.Help"]</h2></div>
        <ul class="connect-list">
            <li><a href="@ConnectModel.FirestormHelp" rel="noopener noreferrer">@T["Connect.FirestormHelp"]</a></li>
            @if (Model.DisplayName.Length == 0)
            {
                <li><a href="/signup">@T["Connect.MakeAccount"]</a></li>
            }
            <li><a href="/guest/forgot-password">@T["Connect.ForgotPassword"]</a></li>
            <li><a href="/support">@T["Connect.AskStaff"]</a></li>
            @foreach (var (id, _) in Model.HelpPages)
            {
                <li><a href="/@id">@T.LegalTitle(id)</a></li>
            }
        </ul>
    </section>
</div>
<p class="connect-no-support">@T["Connect.NoSupport", Model.GridName]</p>

@section Scripts {
<script src="/js/connect.js" asp-append-version="true"></script>
}
