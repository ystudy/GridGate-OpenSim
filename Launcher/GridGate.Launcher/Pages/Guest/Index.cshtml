@page "/guest"
@model GridGate.Launcher.Pages.Guest.IndexModel
@using GridGate.Launcher.Guests
@inject GridGate.Launcher.Core.Money.MoneyGate MoneyGate
@{
    ViewData["Title"] = T["Avatar.Title"].Value;
    ViewData["AvatarTab"] = "avatar";
    var look = Model.Look;
}
@* The Avatar page's Avatar tab (spec 2026-11-21-avatar-page-design): the signed-in resident's own avatar. *@
<section id="avatar-card" class="avatar-card">
    <div class="avatar-picture">
        @if (Model.HasPicture)
        {
            <img id="avatar-photo" class="avatar-photo" src="/guest/avatar.jpg" alt="">
        }
        else
        {
            <div id="avatar-photo-none" class="avatar-photo front-card-blank" aria-hidden="true"></div>
            <p class="avatar-hint">@T["Avatar.NoPicture"]</p>
        }
    </div>
    <div class="avatar-text">
        <h1 id="avatar-name">@Model.DisplayName</h1>
        @if (Model.Since is { } since)
        {
            <p class="tone-text avatar-since">@T["Residents.MemberSince", since]</p>
        }
        <p id="avatar-presence" class="avatar-presence @(Model.InWorld ? "avatar-presence-on" : "")">
            <span class="avatar-dot" aria-hidden="true"></span>
            @(Model.InWorld
                ? (Model.Region is { } region ? T["Avatar.InWorldIn", region].Value : T["Avatar.InWorld"].Value)
                : T["Avatar.NotInWorld"].Value)
        </p>
        @if (Model.PublicPage is { } publicPage)
        {
            <p><a id="avatar-public-page" href="@publicPage">@T["Avatar.SeePublicPage"]</a></p>
        }
        else
        {
            <p><a id="avatar-public-page" href="/guest/account#public-profile">@T["Avatar.ShowOnResidents"]</a></p>
        }
    </div>
</section>

<section id="avatar-wearing" class="avatar-section">
    <h2>@T["Avatar.Wearing"]</h2>
    @if (look.State == AvatarLookState.Unavailable)
    {
        <p id="avatar-look-unavailable" role="status">@T["Avatar.LookUnavailable"]</p>
    }
    else if (look.State == AvatarLookState.NotSaved || look.Look!.IsEmpty)
    {
        <p id="avatar-look-none">@T["Avatar.LookNotSaved"]</p>
    }
    else
    {
        <div class="avatar-groups">
            @foreach (var (id, key, lines) in new (string, string, IReadOnlyList<WornLine>)[]
                { ("avatar-body", "Avatar.Body", look.Look.Body), ("avatar-clothes", "Avatar.Clothes", look.Look.Clothes),
                  ("avatar-attached", "Avatar.Attached", look.Look.Attached), ("avatar-huds", "Avatar.Huds", look.Look.Huds) })
            {
                if (lines.Count == 0) continue;
                <section id="@id" class="card avatar-group">
                    <h3>@T[key]</h3>
                    <ul>
                        @foreach (var line in lines)
                        {
                            <li>
                                @if (line.Type is { } type)
                                {
                                    <span class="avatar-type">@T[type]</span>
                                }
                                <span class="avatar-item">@(line.Name ?? T["Avatar.ItemGone"].Value)</span>
                                @if (line.Name is not null && line.Creator is { } creator)
                                {
                                    <span class="avatar-creator">@T["Avatar.By", creator]</span>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    }
</section>

<div class="avatar-columns">
    <section id="avatar-get-in" class="card avatar-box">
        <h2>@T["Guest.ConnectHeading"]</h2>
        <ol>
            <li>@T.With("Guest.Step1", ResidentHtml.Link("https://www.firestormviewer.org/downloads/", "https://www.firestormviewer.org/downloads/"))</li>
            <li>@T["Guest.Step2"]</li>
            <li>@T.With("Guest.Step3", ResidentHtml.Code(Model.LoginUri))</li>
            <li>@T["Guest.Step4", Model.GridName]</li>
        </ol>
        <p class="mb-0"><a href="/guest/connect">@T["Common.HowToConnect"]</a></p>
    </section>
    <section id="avatar-things" class="card avatar-box">
        <h2>@T["Avatar.Things"]</h2>
        <ul class="avatar-links">
            <li><a href="/guest/account">@T["Account.Title"]</a></li>
            @if (MoneyGate.ServiceHere)
            {
                <li><a href="/guest/coins">@T["MyCoins.Title"]</a></li>
            }
            @if (Model.OwnsRegions)
            {
                <li><a href="/guest/regions">@T["Regions.Title"]</a></li>
            }
            @if (Model.UploadLink)
            {
                <li><a href="/guest/upload">@T["Upload.Title"]</a></li>
            }
            @if (Model.InventoryLink)
            {
                <li><a href="/guest/inventory">@T["Iar.Title"]</a></li>
            }
            @if (Model.TwoFactorLink)
            {
                <li><a href="/guest/two-factor">@T["Common.TwoFactorSignIn"]</a></li>
            }
        </ul>
        <form method="post" action="/guest/sign-out" asp-antiforgery="true">
            <button type="submit" class="btn btn-outline-secondary">@T["Guest.SignOut"]</button>
        </form>
    </section>
</div>
