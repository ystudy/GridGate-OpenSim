@model GridGate.Launcher.Setup.JoinFoundModel
@using GridGate.Launcher.Setup
@*
    What a Grid Asset Server's join information says, with "Join this grid" and "Change the address". Shared by the
    setup join step and Advanced settings. Model: JoinFoundModel (Found, Address, Repoint: what moving regions keeps, on Advanced). On Advanced the confirm form also asks for the
    owner's password (AskPassword) and two-factor code (AskCode), or says where to turn two-factor on (NeedsTwoFactor). "Change the address" skips that check (formnovalidate); both post to the page's own Confirm and Change
    handlers, and Confirm reads the join information again before saving.
*@
@{
    var warning = JoinForm.VersionWarning(Model.Found);
}
<div class="join-found mt-3">
    <p>GridGate found this grid at <strong>@Model.Address</strong>:</p>
    <ul class="join-details">
        <li>Grid: <strong>@Model.Found.GridName</strong></li>
        <li>The Grid Asset Server's GridGate version: <strong>@Model.Found.Version</strong></li>
        <li>Hypergrid: <strong>@(Model.Found.Hypergrid ? "on" : "off")</strong></li>
    </ul>
    @if (warning is not null)
    {
        <div class="version-warning alert alert-warning">@warning</div>
    }
    @if (Model.Repoint)
    {
        <p class="join-repoint">Your regions keep their land, objects and estate. Things made on the old grid may lose their textures on the new one, because those are kept by the Grid Asset Server.</p>
    }
    <form method="post">
        <input type="hidden" name="Address" value="@Model.Address">
        @if (Model.AskPassword)
        {
            <label class="form-label" for="Password">Your avatar's password on @Model.Found.GridName</label>
            <input class="form-control mb-2" type="password" id="Password" name="Password" autocomplete="current-password" required>
            <span class="hint form-text d-block mb-3">GridGate checks it with that grid before anything changes. After the move you sign in with it.</span>
        }
        @if (Model.AskCode)
        {
            <label class="form-label" for="TwoFactorCode">Your two-factor code</label>
            <input class="form-control mb-2" id="TwoFactorCode" name="TwoFactorCode" maxlength="32" autocomplete="one-time-code" inputmode="numeric" spellcheck="false" required>
            <span class="hint form-text d-block mb-3">The current code from your authenticator app. This computer checks it itself, so nobody on the grid can reset it. Wait for a new one if you just used it.</span>
        }
        @if (Model.NeedsTwoFactor)
        {
            <p class="join-two-factor">Moving to another grid takes your two-factor code, and two-factor sign-in isn't on for your account on this computer. <a href="@GridGate.Launcher.Security.OwnerCodeStep.TurnOnPath">Turn on two-factor</a>, then come back here.</p>
        }
        else
        {
            <button type="submit" class="btn btn-primary" asp-page-handler="Confirm">Join this grid</button>
        }
        <button type="submit" class="btn btn-outline-secondary" formnovalidate asp-page-handler="Change">Change the address</button>
    </form>
</div>
