@using System.Globalization
@using GridGate.Launcher.Core.Settings
@inject Func<LauncherSettings> Settings
@inject GridGate.Launcher.Core.Theme.ThemeStore Theme
@{
    var gridName = Settings().GridName;
    // The owner's logo from the splash editor; null when none is set or its file is gone, and then the name stands alone.
    var logo = Theme.Logo();
    // A resident signed in at the guest door, asked of the guest cookie itself (a staff page's User is the staff sign-in).
    var resident = (await Microsoft.AspNetCore.Authentication.AuthenticationHttpContextExtensions.AuthenticateAsync(Context, GridGate.Launcher.Security.AuthSchemes.Guest)).Principal;
    var residentName = resident?.Identity?.Name is { Length: > 0 } n ? n : null;
    // Asked of the staff cookie itself: on the guest pages User is the guest sign-in (the Guest policy's scheme).
    var staffUser = (await Microsoft.AspNetCore.Authentication.AuthenticationHttpContextExtensions.AuthenticateAsync(Context, GridGate.Launcher.Security.AuthSchemes.Admin)).Principal;
    var isStaff = staffUser is not null && GridGate.Launcher.Security.StaffSignIn.RoleOf(staffUser) != GridGate.Launcher.Core.Security.StaffRole.None;
    // From the culture the page is rendered in (ResidentLanguageFilter sets it), so what is written here is what the page really uses.
    var culture = CultureInfo.CurrentUICulture;
    var rtl = culture.TextInfo.IsRightToLeft;
    var lang = culture.TwoLetterISOLanguageName is { Length: 2 } two ? two : "en";
    // The public look (guest.css) plus the page's width, if it asks for more room.
    var bodyClass = ViewData["Wide"] switch { true => "guest-site page-wide", "full" => "guest-site page-full", _ => "guest-site" };
}
<!DOCTYPE html>
@* Always dark (spec 2026-11-17-public-look-design): no theme.js here, and guest.css after site.css. *@
<html lang="@lang" dir="@(rtl ? "rtl" : "ltr")" data-bs-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ViewData["Title"] is string t ? t + " - " : "")@gridName</title>
    <link rel="stylesheet" href="@(rtl ? "/lib/bootstrap/bootstrap.rtl.min.css" : "/lib/bootstrap/bootstrap.min.css")">
    <link rel="stylesheet" href="/css/site.css">
    <link rel="stylesheet" href="/css/guest.css">
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="@bodyClass">
@* The public top bar: the grid's logo and name, the visitor's account buttons and the menu. Nothing of the staff side. *@
<header class="site-bar">
    <div class="container site-bar-row">
        <a id="site-home" class="site-home" href="/home">
            @if (logo is not null)
            {
                <img id="site-logo" class="site-logo" src="@GridGate.Launcher.Splash.SplashSnapshot.LogoUrl(logo)" alt="@gridName">
            }
            <span class="grid-name">@gridName</span>
        </a>
        <div class="guest-actions">
            @if (isStaff)
            {
                @* A staff member looking at the guest side (the staff menu's Guest view): only the way back. *@
                <a id="staff-side-link" class="btn btn-sm btn-primary" href="/" icon="arrow-left">@T["Layout.BackToStaff"]</a>
                IgnoreSection("HeaderActions");
            }
            else
            {
                if (residentName is not null)
                {
                    <a id="resident-link" class="btn btn-sm btn-outline-secondary site-account" href="/guest" icon="person">@residentName</a>
                    @* Signing out is a POST with the antiforgery token, never a link (SignOutModel). *@
                    <form id="sign-out-form" class="d-inline" method="post" action="/guest/sign-out" asp-antiforgery="true">
                        <button type="submit" class="btn btn-sm btn-outline-secondary site-account" icon="sign-out">@T["Guest.SignOut"]</button>
                    </form>
                }
                else
                {
                    <a id="login-link" class="btn btn-sm btn-outline-secondary site-account" href="/guest/sign-in" icon="sign-in">@T["Common.SignIn"]</a>
                    @* Only while sign-up is open: a closed grid links no one to /signup (as the sign-in page). *@
                    if (GridGate.Launcher.Core.Guests.SignUpRules.IsOpen(Settings()))
                    {
                        <a id="register-link" class="btn btn-sm btn-primary site-account" href="/signup" icon="plus">@T["Layout.Register"]</a>
                    }
                }
                @await RenderSectionAsync("HeaderActions", required: false)
            }
            @* The menu: a <details>, so it opens without a script and by keyboard. Only pages that exist are listed. *@
            <details id="site-menu" class="site-menu">
                <summary aria-label="@T["Layout.Menu"]"><span aria-hidden="true">&#9776;</span><span class="visually-hidden">@T["Layout.Menu"]</span></summary>
                <div class="site-menu-panel">
                    <nav aria-label="@T["Layout.Menu"]">
                        @* Not buttons, so ButtonIcons does not add their icons: they are written here. *@
                        <a id="menu-home" href="/home">@Html.Raw(GridGate.Launcher.Navigation.ButtonIcons.Svg("flag"))@T["Layout.MenuHome"]</a>
                        <a id="menu-connect" href="/guest/connect">@Html.Raw(GridGate.Launcher.Navigation.ButtonIcons.Svg("link"))@T["Layout.MenuConnect"]</a>
                        <a id="help-link" href="/support">@Html.Raw(GridGate.Launcher.Navigation.ButtonIcons.Svg("help"))@T["Layout.Help"]</a>
                        <a id="menu-reset" href="/guest/forgot-password">@Html.Raw(GridGate.Launcher.Navigation.ButtonIcons.Svg("key"))@T["Layout.MenuResetPassword"]</a>
                    </nav>
                    <partial name="_LanguagePicker" />
                </div>
            </details>
        </div>
    </div>
</header>
<main class="container py-4">
    @RenderBody()
</main>
@* The footer: the legal pages the operator has written, the copyright line, the staff door (not for staff already signed in),
   then anything a page puts in a "Footer" section. *@
<footer id="site-footer" class="site-footer">
    <div class="container">
        <partial name="_LegalLinks" />
        <p id="site-copyright" class="site-copyright">@T["Layout.Copyright", gridName]</p>
        @if (!isStaff)
        {
            @* Not a button, so its icon is written here (ButtonIcons decorates .btn only). *@
            <a id="staff-link" class="site-staff-link" href="/login">@Html.Raw(GridGate.Launcher.Navigation.ButtonIcons.Svg("shield"))@T["Home.StaffSignIn"]</a>
        }
        @await RenderSectionAsync("Footer", required: false)
    </div>
</footer>
<script src="/js/copy.js"></script>
<script src="/js/language.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
