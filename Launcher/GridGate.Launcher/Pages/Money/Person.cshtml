@page "/money/person"
@model GridGate.Launcher.Pages.Money.PersonModel
@using GridGate.Launcher.Money
@{
    ViewData["Title"] = "Coins: " + Model.Name;
    ViewData["Wide"] = true;
    var query = "id=" + Model.Id + (string.IsNullOrEmpty(Model.Home) ? "" : "&home=" + Uri.EscapeDataString(Model.Home));
}
<div class="page-head">
    <h1>@Model.Name<help-tip class="help-start">This person's coins. Every change here needs a reason and is written to the audit log.</help-tip></h1>
    <p><a href="/money">Back to Money</a></p>
</div>
<error-box text="@Model.Error" />
<ok-box text="@Model.Notice" />
@if (Model.DatabaseDown)
{
    <div class="error-box error alert alert-danger" role="alert">The money database can't be reached right now.</div>
}
<div class="list-columns">
    <section class="work-panel" aria-labelledby="person-now-title">
        <h2 id="person-now-title" class="panel-title">Money and limits<help-tip>Whether this person can pay and be paid right now, and how much of their daily limits the last 24 hours used.</help-tip></h2>
        <p id="person-money-here">Money here now: @Model.MoneyHere<help-tip>Money works for someone only while the money service knows where they are: they logged in, or a verified region handed them on. Arriving from a region that can't verify where they are pauses it until their next login.</help-tip>
            @if (Model.MoneyHereAnchor is { } anchor)
            {
                <a href="@MoneyVerifyText.Link(anchor)" target="_blank" rel="noopener noreferrer">Why</a>
            }
        </p>
        @if (Model.Limits is { } limits)
        {
            <p id="person-limits">
                @PersonModel.LimitLine("Daily spending", limits.SpentToday, limits.DailySpend, limits.OwnSpend, limits.Until)<help-tip>What regions took from their wallet in the last 24 hours: paying, buying, land, passes and fees.</help-tip><br>
                @PersonModel.LimitLine("Daily script payouts", limits.PaidOutToday, limits.DailyPayout, limits.OwnPayout, limits.Until)<help-tip>What their own scripts paid out of their wallet in the last 24 hours.</help-tip>
            </p>
            @if (Model.CanSetLimits)
            {
                <form method="post" action="/money/person?handler=Limits&@query" asp-antiforgery="true">
                    <h3 class="h6">Set this person's limits<help-tip>Higher or lower than the grid's, for example higher for a land sale, or lower when they ask. Leave a box empty for the grid default; leave both empty to go back to the defaults.</help-tip></h3>
                    <label class="form-label" for="limit-spend">Daily spending limit</label>
                    <input class="form-control mb-2" id="limit-spend" name="DailySpend" type="number" min="0" max="@MoneyPageRules.MaxDailyPayoutLimit" placeholder="Grid default"
                           value="@(limits.OwnSpend ? (long?)limits.DailySpend : null)">
                    <label class="form-label" for="limit-payout">Daily script payout limit</label>
                    <input class="form-control mb-2" id="limit-payout" name="DailyPayout" type="number" min="0" max="@MoneyPageRules.MaxDailyPayoutLimit" placeholder="Grid default"
                           value="@(limits.OwnPayout ? (long?)limits.DailyPayout : null)">
                    <label class="form-label" for="limit-until">Ends on (optional; UTC, the limits end at 00:00 UTC that day)</label>
                    <input class="form-control mb-2" id="limit-until" name="Until" type="date" value="@(limits.Until?.ToString("yyyy-MM-dd"))">
                    <label class="form-label" for="limit-reason">Reason</label>
                    <input class="form-control mb-2" id="limit-reason" name="Reason" maxlength="@MoneyPageRules.MaxReason" required>
                    <button type="submit" class="btn btn-outline-secondary">Set limits</button>
                </form>
            }
        }
        else if (!Model.DatabaseDown)
        {
            <p id="person-limits-none">No wallet yet, so the grid's daily limits apply.</p>
        }
        <p class="mb-0"><a href="@MoneyVerifyText.Link(MoneyVerifyText.OwnLimitsAnchor)" target="_blank" rel="noopener noreferrer">Giving one person their own limits</a></p>
    </section>
    <section class="work-panel" aria-labelledby="person-balance-title">
        <h2 id="person-balance-title" class="panel-title">Balance</h2>
        <p id="person-balance" class="fs-4">@(Model.Balance is { } b ? Model.Symbol + PersonModel.N(b) : "—")</p>
        @if (Model.NoWallet)
        {
            <p id="person-no-wallet">No wallet yet. Giving coins makes one.</p>
        }
        @if (Model.Flags is { } flags)
        {
            <p id="person-flags">@(flags.Frozen ? "Frozen: this account can't pay anyone." : "Not frozen.") @(flags.PayoutsAllowed ? "Their scripts may pay out." : "Their scripts may not pay out.")</p>
        }
        @if (Model.CanChange)
        {
            <form method="post" action="/money/person?handler=Give&@query" asp-antiforgery="true" class="mb-3">
                <label class="form-label" for="give-amount">Give</label>
                <input class="form-control mb-2" id="give-amount" name="Amount" type="number" min="1" required>
                <label class="form-label" for="give-reason">Reason</label>
                <input class="form-control mb-2" id="give-reason" name="Reason" maxlength="200" required>
                <button type="submit" class="btn btn-outline-secondary">Give coins</button>
            </form>
            <form method="post" action="/money/person?handler=Take&@query" asp-antiforgery="true" class="mb-3">
                <label class="form-label" for="take-amount">Take</label>
                <input class="form-control mb-2" id="take-amount" name="Amount" type="number" min="1" required>
                <label class="form-label" for="take-reason">Reason</label>
                <input class="form-control mb-2" id="take-reason" name="Reason" maxlength="200" required>
                <button type="submit" class="btn btn-outline-danger">Take coins</button>
            </form>
            <div class="d-flex flex-wrap gap-2">
                <form method="post" action="/money/person?handler=@(Model.Flags?.Frozen == true ? "UnfreezeAccount" : "FreezeAccount")&@query" asp-antiforgery="true">
                    <button type="submit" class="btn btn-outline-secondary">@(Model.Flags?.Frozen == true ? "Unfreeze account" : "Freeze account")</button>
                </form>
                @if (!Model.IsVisitor)
                {
                    <form method="post" action="/money/person?handler=Payouts&@query" asp-antiforgery="true">
                        <input type="hidden" name="On" value="@(Model.Flags?.PayoutsAllowed == true ? "false" : "true")">
                        <button type="submit" class="btn btn-outline-secondary">@(Model.Flags?.PayoutsAllowed == true ? "Stop their script payouts" : "Let their scripts pay out")</button>
                    </form>
                }
            </div>
            @if (Model.IsVisitor)
            {
                <form method="post" action="/money/person?handler=Merge&@query" asp-antiforgery="true" class="mt-3">
                    <label class="form-label" for="merge-home">Move to a new home address<help-tip>When the visitor's home grid changes its address, their coins move to the wallet under the new address. The old wallet is frozen.</help-tip></label>
                    <input class="form-control mb-2" id="merge-home" name="NewHome" maxlength="255" placeholder="http://grid.example:8002/" required>
                    <label class="form-label" for="merge-reason">Reason</label>
                    <input class="form-control mb-2" id="merge-reason" name="Reason" maxlength="200" required>
                    <button type="submit" class="btn btn-outline-secondary">Move coins</button>
                </form>
            }
        }
    </section>
    <section class="work-panel" aria-labelledby="person-history-title">
        <h2 id="person-history-title" class="panel-title">History</h2>
        @if (Model.History.Count == 0)
        {
            <p class="mb-0">Nothing yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table id="person-history" class="table align-middle mb-0">
                    <thead><tr><th>Entry</th><th>When</th><th>What</th><th>Amount</th><th>Balance</th><th>Note</th></tr></thead>
                    <tbody>
                    @foreach (var line in Model.History)
                    {
                        <tr>
                            <td class="cell">@line.EntryId</td>
                            <td class="cell">@line.At.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@line.Type</td>
                            <td class="cell">@(line.Amount > 0 ? "+" : "")@PersonModel.N(line.Amount)</td>
                            <td class="cell">@PersonModel.N(line.BalanceAfter)</td>
                            <td>@(line.Reason ?? line.ObjectName)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
