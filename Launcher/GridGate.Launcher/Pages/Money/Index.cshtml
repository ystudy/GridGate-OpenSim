@page "/money"
@model GridGate.Launcher.Pages.Money.IndexModel
@using GridGate.Launcher.Core.Money
@using GridGate.Launcher.Core.OpenSim
@using GridGate.Launcher.Money
@{
    ViewData["Title"] = "Money";
    ViewData["Wide"] = true;
    var m = Model.Saved;
    var f = Model.Form;
}
<div class="page-head">
    <h1>Money<help-tip class="help-start">The grid's coins: what they're called, what things cost, and the books.</help-tip></h1>
</div>
<error-box text="@Model.Error" />
<ok-box text="@Model.Notice" />
@if (Model.DatabaseDown)
{
    <div id="money-database-down" class="error-box error alert alert-danger" role="alert">The money database can't be reached, so payments are refused and the books can't be shown.</div>
}
<div class="list-columns">
    <section class="work-panel" aria-labelledby="money-settings-title">
        <h2 id="money-settings-title" class="panel-title">Settings</h2>
        @if (!Model.Offered.Contains(MoneyMode.Play))
        {
            <p id="money-approval">Play coins become available once the money safety review is approved.</p>
        }
        @if (Model.CanChange)
        {
            <form id="money-settings" method="post" action="/money?handler=Settings" asp-antiforgery="true">
                <label class="form-label" for="money-mode">Mode</label>
                <select class="form-select mb-3" id="money-mode" name="Mode">
                    @foreach (var mode in Model.Offered)
                    {
                        <option value="@mode" selected="@(mode == f.Mode)" disabled="@Model.ModeLocked(mode)">@(mode switch { MoneyMode.Off => "Off", MoneyMode.Gloebit => "Gloebit", _ => "Play coins" })</option>
                    }
                </select>
                @if (Model.Offered.Contains(MoneyMode.Gloebit) && !Model.IsOwner)
                {
                    <p id="money-gloebit-owner" class="form-text mt-0 mb-3">@MoneyPageRules.OwnerOnlyNote</p>
                }
                <div class="row g-3">
                    <div class="col-sm-6"><label class="form-label" for="money-symbol">Currency symbol</label>
                        <input class="form-control" id="money-symbol" name="CurrencySymbol" value="@f.CurrencySymbol" maxlength="4" required></div>
                    <div class="col-sm-6"><label class="form-label" for="money-name">Currency name</label>
                        <input class="form-control" id="money-name" name="CurrencyName" value="@f.CurrencyName" maxlength="20" required></div>
                    <div class="col-sm-6"><label class="form-label" for="money-start-play">Starting balance (play)</label>
                        <input class="form-control" id="money-start-play" name="StartingBalancePlay" type="number" min="0" value="@f.StartingBalancePlay"></div>
                    <div class="col-sm-6"><label class="form-label" for="money-start-real">Starting balance (real)</label>
                        <input class="form-control" id="money-start-real" name="StartingBalanceReal" type="number" min="0" value="@f.StartingBalanceReal"></div>
                    <div class="col-sm-6"><label class="form-label" for="money-allowance">Weekly allowance</label>
                        <input class="form-control" id="money-allowance" name="WeeklyAllowance" type="number" min="0" value="@f.WeeklyAllowance"></div>
                    <div class="col-sm-6"><label class="form-label" for="money-upload">Upload fee</label>
                        <input class="form-control" id="money-upload" name="UploadFee" type="number" min="0" value="@f.UploadFee"></div>
                    <div class="col-sm-6"><label class="form-label" for="money-classified">Classified ad fee</label>
                        <input class="form-control" id="money-classified" name="ClassifiedFee" type="number" min="0" value="@f.ClassifiedFee"></div>
                    <div class="col-sm-6"><label class="form-label" for="money-max">Largest payment</label>
                        <input class="form-control" id="money-max" name="MaxPayment" type="number" min="1" value="@f.MaxPayment"></div>
                </div>
                <h3 class="h6 mt-3">Daily limits<help-tip>Each limit counts the last 24 hours, rolling, so there is no midnight reset to time an attack around. Staff gifts, take-backs and refunds never count. These are the grid's defaults: the owner can give one person, one region program or one Region Server its own.</help-tip></h3>
                <div class="row g-3">
                    <div class="col-sm-6"><label class="form-label" for="money-spend">Daily spending limit per person<help-tip>The most coins regions may take from one person's wallet in a day: paying, buying, land, passes and fees.</help-tip></label>
                        <input class="form-control" id="money-spend" name="DailySpendLimit" type="number" min="0" max="@MoneyPageRules.MaxDailyPayoutLimit" value="@f.DailySpendLimit"></div>
                    <div class="col-sm-6"><label class="form-label" for="money-key-spend">Daily region limit per region program or Region Server<help-tip>The most coins all the regions of one region program, or of one Region Server, may take from everyone's wallets in a day.</help-tip></label>
                        <input class="form-control" id="money-key-spend" name="DailyKeySpendLimit" type="number" min="0" max="@MoneyPageRules.MaxDailyPayoutLimit" value="@f.DailyKeySpendLimit"></div>
                    <div class="col-sm-6"><label class="form-label" for="money-key-payout">Daily script payouts per region program or Region Server<help-tip>The most coins all the objects in one region program's, or one Region Server's, regions may pay out in a day.</help-tip></label>
                        <input class="form-control" id="money-key-payout" name="DailyKeyPayoutLimit" type="number" min="0" max="@MoneyPageRules.MaxDailyPayoutLimit" value="@f.DailyKeyPayoutLimit"></div>
                    <div class="col-sm-6"><label class="form-label" for="money-daily">Daily script payout limit per resident<help-tip>The most coins one resident's own scripts may pay out of their wallet in a day.</help-tip></label>
                        <input class="form-control" id="money-daily" name="DailyPayoutLimit" type="number" min="0" max="@MoneyPageRules.MaxDailyPayoutLimit" value="@f.DailyPayoutLimit"></div>
                </div>
                <p class="mt-2 mb-0"><a href="@MoneyVerifyText.Link(MoneyVerifyText.LimitsAnchor)" target="_blank" rel="noopener noreferrer">How the daily limits work</a></p>
                <div class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" id="money-scripts" name="ScriptPayouts" value="true" checked="@f.ScriptPayouts">
                    <label class="form-check-label" for="money-scripts">Scripts may pay out, for residents who allow it</label>
                </div>
                @if (Model.Offered.Contains(MoneyMode.Gloebit))
                {
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" id="money-confirm-switch" name="ConfirmSwitch" value="true">
                        <label class="form-check-label" for="money-confirm-switch">When switching between coins and Gloebit: I understand GridGate coin balances don't move to Gloebit. They are kept, and come back if I switch back.</label>
                    </div>
                }
                <button type="submit" class="btn btn-primary mt-3">Save</button>
            </form>
        }
        else
        {
            <dl id="money-settings-view" class="mb-0">
                <dt>Mode</dt><dd>@(m.Mode == MoneyMode.Off ? "Off" : m.Mode.ToString())</dd>
                <dt>Currency</dt><dd>@m.CurrencyName (@m.CurrencySymbol)</dd>
                <dt>Upload fee</dt><dd>@IndexModel.N(m.UploadFee)</dd>
                <dt>Daily spending limit per person</dt><dd>@IndexModel.N(m.DailySpendLimit)</dd>
                <dt>Daily region limit per region program or Region Server</dt><dd>@IndexModel.N(m.DailyKeySpendLimit)</dd>
                <dt>Daily script payouts per region program or Region Server</dt><dd>@IndexModel.N(m.DailyKeyPayoutLimit)</dd>
                <dt>Daily script payout limit per resident</dt><dd>@IndexModel.N(m.DailyPayoutLimit)</dd>
            </dl>
        }
    </section>
    @await Html.PartialAsync("_MoneyVisitors", Model)
    @if (Model.ShowGloebit)
    {
        <section class="work-panel" id="money-gloebit" aria-labelledby="money-gloebit-title">
            <h2 id="money-gloebit-title" class="panel-title">Gloebit<help-tip>Gloebit is an outside service: residents buy gloebits from it and artists cash out through it. This computer's regions use the app you create in Gloebit's merchant tools.</help-tip></h2>
            @if (Model.GloebitMode)
            {
                <p id="money-gloebit-on">Gloebit handles payments on this grid. GridGate coin balances are kept and come back if you switch back to coins.</p>
                @if (Model.GloebitUnreachable)
                {
                    <div class="alert alert-warning" role="alert">Gloebit needs your regions reachable from the internet: purchases and payments call back to them.</div>
                }
            }
            @if (m.Gloebit is { } app)
            {
                <p id="money-gloebit-app">App: @app.Environment, key @GridGate.Launcher.Core.Money.GloebitRules.Masked(app.Key), secret @(app.Secret.Length > 0 ? "saved" : "not set").</p>
            }
            @if (Model.IsOwner)
            {
                @await Html.PartialAsync("_GloebitForm", new GridGate.Launcher.Money.GloebitFormModel(m.Gloebit, "/money?handler=Gloebit"))
            }
        </section>
    }
    @if (Model.On && !Model.DatabaseDown && Model.Totals is { } t)
    {
        <section class="work-panel" aria-labelledby="money-totals-title">
            <h2 id="money-totals-title" class="panel-title">Totals</h2>
            <dl id="money-totals" class="mb-0">
                <dt>In existence</dt><dd>@m.CurrencySymbol@IndexModel.N(t.InExistence)</dd>
                <dt>With residents</dt><dd>@m.CurrencySymbol@IndexModel.N(t.Residents)</dd>
                <dt>With visitors</dt><dd>@m.CurrencySymbol@IndexModel.N(t.Visitors)</dd>
                <dt>Fees collected</dt><dd>@m.CurrencySymbol@IndexModel.N(t.Fees)</dd>
                <dt>Waiting in purchases</dt><dd>@m.CurrencySymbol@IndexModel.N(t.Holding)</dd>
                <dt>Moved today</dt><dd>@m.CurrencySymbol@IndexModel.N(t.MovedToday)</dd>
            </dl>
        </section>
        @await Html.PartialAsync("_MoneyAlerts", Model)
        @await Html.PartialAsync("_MoneyRegions", Model)
        <section class="work-panel" aria-labelledby="money-check-title">
            <h2 id="money-check-title" class="panel-title">Self-check</h2>
            @if (Model.LastCheck is { } last)
            {
                <p id="money-last-check">@(last.Result.Ok ? "The books add up." : "The last check found a difference.") Checked @last.At.ToString("yyyy-MM-dd HH:mm 'UTC'").</p>
                @if (!last.Result.Ok)
                {
                    <ul id="money-check-problems">
                        @foreach (var mismatch in last.Result.Mismatches)
                        {
                            <li>Account @mismatch.AccountId has @mismatch.Stored, but its entries add up to @mismatch.FromEntries.</li>
                        }
                        @if (last.Result.Sum != 0)
                        {
                            <li>All balances add up to @last.Result.Sum instead of zero.</li>
                        }
                        @foreach (var p in last.Result.Problems)
                        {
                            <li>@p</li>
                        }
                    </ul>
                }
            }
            else
            {
                <p id="money-last-check">Not checked since GridGate started.</p>
            }
            @if (Model.CanChange)
            {
                <form method="post" action="/money?handler=Check" asp-antiforgery="true">
                    <button type="submit" class="btn btn-outline-secondary">Check now</button>
                </form>
            }
        </section>
        <section class="work-panel" aria-labelledby="money-freeze-title">
            <h2 id="money-freeze-title" class="panel-title">Freeze</h2>
            <p id="money-freeze-state">@(Model.Frozen.Frozen ? $"All payments are frozen: {Model.Frozen.Reason}" : "Payments are running.")</p>
            @if (Model.CanChange)
            {
                <form method="post" action="/money?handler=@(Model.Frozen.Frozen ? "Unfreeze" : "Freeze")" asp-antiforgery="true">
                    <label class="form-label" for="money-freeze-reason">Reason</label>
                    <input class="form-control mb-2" id="money-freeze-reason" name="Reason" maxlength="200" required>
                    <button type="submit" class="btn @(Model.Frozen.Frozen ? "btn-primary" : "btn-outline-danger")">@(Model.Frozen.Frozen ? "Unfreeze payments" : "Freeze all payments")</button>
                </form>
            }
        </section>
        @await Html.PartialAsync("_MoneyLimits", Model)
        @if (Model.CanChange)
        {
            <section class="work-panel" aria-labelledby="money-refund-title">
                <h2 id="money-refund-title" class="panel-title">Refund an entry</h2>
                <form method="post" action="/money?handler=Refund" asp-antiforgery="true">
                    <label class="form-label" for="money-refund-entry">Entry number</label>
                    <input class="form-control mb-2" id="money-refund-entry" name="EntryId" type="number" min="1" required>
                    <label class="form-label" for="money-refund-reason">Reason</label>
                    <input class="form-control mb-2" id="money-refund-reason" name="Reason" maxlength="200" required>
                    <button type="submit" class="btn btn-outline-secondary">Refund</button>
                </form>
            </section>
            <section class="work-panel" aria-labelledby="money-fees-title">
                <h2 id="money-fees-title" class="panel-title">Move fees</h2>
                <form method="post" action="/money?handler=MoveFees" asp-antiforgery="true">
                    <label class="form-label" for="money-fees-name">To resident (first and last name)</label>
                    <input class="form-control mb-2" id="money-fees-name" name="Name" maxlength="64" required>
                    <label class="form-label" for="money-fees-amount">Amount</label>
                    <input class="form-control mb-2" id="money-fees-amount" name="Amount" type="number" min="1" required>
                    <label class="form-label" for="money-fees-reason">Reason</label>
                    <input class="form-control mb-2" id="money-fees-reason" name="Reason" maxlength="200" required>
                    <button type="submit" class="btn btn-outline-secondary">Move</button>
                </form>
            </section>
        }
        @if (Model.ShowServers)
        {
            <section class="work-panel" id="money-servers" aria-labelledby="money-servers-title">
                <h2 id="money-servers-title" class="panel-title">Region Servers<help-tip>A Region Server's regions take payments once it is paired here. Make a code here and type it on the Region Server's Money page.</help-tip></h2>
                <p>A Region Server's key works only for its own regions, never for this computer's.</p>
                @if (Model.NewCode is { } code)
                {
                    <div id="money-pairing-code" class="alert alert-info" role="status">
                        <p class="fs-4 mb-1"><code>@code</code></p>
                        <p class="mb-0">Type this on the Region Server's Money page within 15 minutes. It works once.</p>
                    </div>
                }
                else if (Model.PairingUntil is { } until)
                {
                    <p id="money-pairing-waiting">A pairing code is waiting until @until.ToString("HH:mm") UTC.</p>
                }
                @if (Model.CanChange)
                {
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <form method="post" action="/money?handler=PairingCode" asp-antiforgery="true">
                            <button type="submit" class="btn btn-outline-secondary">Make a pairing code</button>
                        </form>
                        @if (Model.PairingUntil is not null && Model.NewCode is null)
                        {
                            <form method="post" action="/money?handler=PairingCancel" asp-antiforgery="true">
                                <button type="submit" class="btn btn-outline-secondary">Cancel the code</button>
                            </form>
                        }
                    </div>
                }
                @if (Model.Servers.Count == 0)
                {
                    <p class="mb-0">No Region Server is paired.</p>
                }
                else
                {
                    <ul id="money-paired" class="mb-0">
                        @foreach (var server in Model.Servers)
                        {
                            var heard = Model.KeysHeard.GetValueOrDefault(MoneyVerifyText.KeyOf(server));
                            var serverStatus = heard?.Status ?? RegionStatus.NoGridGateMoney;
                            <li id="money-server-@server.Id">
                                @server.Host@(server.FirstPort > 0 ? $", region ports from {server.FirstPort}" : ""), paired @server.PairedAt.ToString("yyyy-MM-dd")
                                @if (!Model.RegionsDown)
                                {
                                    <span class="money-server-status">
                                        · @MoneyVerifyText.Words(serverStatus)@(heard is null ? "" : $", money protocol {heard.Protocol}")<help-tip>@MoneyVerifyText.ServerHelp(serverStatus)</help-tip>
                                        @if (serverStatus != RegionStatus.Verified)
                                        {
                                            <a href="@MoneyVerifyText.Link(MoneyVerifyText.Anchor(serverStatus))" target="_blank" rel="noopener noreferrer">How to fix</a>
                                        }
                                    </span>
                                }
                                @if (Model.CanChange)
                                {
                                    <form method="post" action="/money?handler=RemoveServer" asp-antiforgery="true" class="d-inline">
                                        <input type="hidden" name="Server" value="@server.Id">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>
        }
        <section class="work-panel" aria-labelledby="money-find-title">
            <h2 id="money-find-title" class="panel-title">Find a person</h2>
            <form method="get" action="/money" role="search">
                <label class="form-label" for="money-find">Part of a name</label>
                <input class="form-control mb-2" id="money-find" name="Q" value="@Model.Q" maxlength="64">
                <button type="submit" class="btn btn-outline-secondary">Find</button>
            </form>
            @if (Model.SearchDown)
            {
                <p class="mt-2">The account list can't be read right now.</p>
            }
            else if (!string.IsNullOrWhiteSpace(Model.Q))
            {
                <ul id="money-found" class="mt-2 mb-0">
                    @foreach (var p in Model.Found)
                    {
                        <li><a href="/money/person?id=@p.Account.PrincipalId">@p.Account.FullName()</a></li>
                    }
                    @foreach (var v in Model.FoundVisitors)
                    {
                        <li><a href="/money/person?id=@v.Id&home=@Uri.EscapeDataString(v.Home)">@IndexModel.VisitorLabel(v)</a></li>
                    }
                </ul>
            }
        </section>
    }
</div>
