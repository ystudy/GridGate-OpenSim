@page "/home"
@model GridGate.Launcher.Pages.HomeModel
@using GridGate.Launcher.Core.Guests
@{
    Layout = "_GuestLayout";
    ViewData["Title"] = T["Home.Title"].Value;
    ViewData["Wide"] = true;
    var view = Model.View;
    var main = Model.Main;
    var heroClass = view.PhotoUrl is null ? "front-hero front-hero-plain" : "front-hero";
}
@* The front page (spec 2026-11-19-front-page-design): a section is left out when it has nothing to show. *@
<section id="front-hero" class="@heroClass">
    @if (view.PhotoUrl is { } photo)
    {
        @* A real picture behind the words (the site's style policy allows no inline styles); decoration only, so no alt text. *@
        <img class="front-hero-photo" src="@photo" alt="">
    }
    <div class="front-hero-words">
        <h1>@Model.GridName</h1>
        <p class="tone-text">@T["Home.Intro", Model.GridName]</p>
        <div class="front-actions">
            <a id="front-main" class="btn btn-lg btn-primary" href="@main.Href" icon="@main.Icon">@T[main.Key]</a>
            <a id="front-connect" class="btn btn-lg btn-secondary" href="/guest/connect" icon="link">@T["Home.HowToConnect"]</a>
        </div>
    </div>
</section>

@if (view.Numbers.Count > 0)
{
    <section id="front-numbers" class="front-numbers" aria-label="@T["Home.NumbersLabel"]">
        @foreach (var n in view.Numbers)
        {
            <div class="front-number">
                <span class="front-number-value">@n.Value</span>
                <span class="front-number-label">@T[n.Key]</span>
            </div>
        }
    </section>
}

@if (view.Places.Count > 0)
{
    <section id="front-places" class="front-section" aria-labelledby="front-places-title">
        <h2 id="front-places-title">@T["Home.FeaturedPlaces"]</h2>
        <div class="front-cards-grid">
            @foreach (var p in view.Places)
            {
                <article class="front-card card">
                    @if (p.PictureUrl is { } picture)
                    {
                        <img class="front-card-picture" src="@picture" alt="" loading="lazy">
                    }
                    else
                    {
                        <div class="front-card-picture front-card-blank" aria-hidden="true"></div>
                    }
                    <div class="front-card-body">
                        <h3 class="front-card-name">@p.Name</h3>
                        @if (p.Line is { } line)
                        {
                            <p class="front-card-line">@line</p>
                        }
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (view.News.Count > 0)
{
    <section id="front-news" class="front-section" aria-labelledby="front-news-title">
        <h2 id="front-news-title">@T["Home.News"]</h2>
        @foreach (var n in view.News)
        {
            <article class="front-news-item">
                <time datetime="@n.Date.ToString("yyyy-MM-dd")">@n.Date.ToString("D", System.Globalization.CultureInfo.CurrentUICulture)</time>
                <div class="front-news-text">@Html.Raw(LegalMarkdown.ToHtml(n.Text, topHeading: 3))</div>
            </article>
        }
    </section>
}

@if (view.Main != GridGate.Launcher.Front.FrontMainButton.YourAccount)
{
    <section id="front-join" class="front-join" aria-labelledby="front-join-title">
        <h2 id="front-join-title">@T["Home.ReadyToJoin"]</h2>
        <a id="front-join-main" class="btn btn-lg btn-primary" href="@main.Href" icon="@main.Icon">@T[main.Key]</a>
    </section>
}
